# Copy to .env and fill in what you use. Every setting in config.py can be set here.

# --- Claude writes hooks, titles and captions (optional; templates otherwise)
ANTHROPIC_API_KEY=

# --- Which platforms to schedule for, and your audience's timezone
PLATFORMS=youtube,instagram,tiktok
TIMEZONE=America/New_York
YOUTUBE_POSTS_PER_DAY=2
INSTAGRAM_POSTS_PER_DAY=1
TIKTOK_POSTS_PER_DAY=3

# --- Branding (optional)
BRAND_HANDLE=@yourhandle
SERIES_NAME=CAD Challenge

# --- YouTube: put the OAuth "Desktop app" JSON in secrets/youtube_client_secret.json,
#     then run: python main.py auth youtube
YOUTUBE_PRIVACY=public
YOUTUBE_PLAYLIST_ID=

# --- Instagram (Graph API, Business/Creator account)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# graph.facebook.com for Facebook-Login tokens, graph.instagram.com for Instagram-Login tokens
GRAPH_API_HOST=graph.facebook.com

# --- TikTok (Content Posting API)
TIKTOK_ACCESS_TOKEN=
# draft = lands in your TikTok inbox so you can add a trending sound; direct = post immediately
TIKTOK_MODE=draft

# --- Rendering
USE_GPU=true
RENDER_SAMPLES=32
# BLENDER_BIN=/opt/blender/blender
